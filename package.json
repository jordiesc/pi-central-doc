{
  "name": "pi-central-doc",
  "version": "0.1.0",
  "description": "Pi extension that consults a central documentation hub in an isolated research session, and publishes files or session output into it.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "documentation",
    "docs",
    "research"
  ],
  "license": "MIT",
  "author": "jordiesc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jordiesc/pi-central-doc.git"
  },
  "homepage": "https://github.com/jordiesc/pi-central-doc#readme",
  "bugs": {
    "url": "https://github.com/jordiesc/pi-central-doc/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "index.ts",
    "config.ts",
    "publish.ts",
    "pi-central-doc.example.json",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "@types/node": "^22.15.3",
    "typebox": "^1.3.27",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit"
  }
}
